# iPhone Add-to-Home-Screen metadata: always revalidate
/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/binancinvest-manifest-v2.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate

/apple-touch-icon.png
  Cache-Control: public, max-age=300

/app-icon-192.png
  Cache-Control: public, max-age=300

/app-icon-512.png
  Cache-Control: public, max-age=300
